# PostgreSQL connection string (Railway provides this automatically when you add a Postgres plugin)
DATABASE_URL="postgresql://postgres:password@localhost:5432/team_task_manager?schema=public"

# JWT secret — generate a secure random string. On Railway, set this in service variables.
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-this-with-a-long-random-secret-at-least-32-chars"

# JWT expiration
JWT_EXPIRES_IN="7d"

# Public app URL (used for absolute redirects). Optional in dev.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"
